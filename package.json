    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^5.1.4"
  }
